# =============================================================================
# AI Workspace — Environment Configuration
# =============================================================================
# Copy to .env and set values. Never commit .env.
# Independent of apps/backend/.env (HRMS runtime).
# =============================================================================

# -----------------------------------------------------------------------------
# Workspace
# -----------------------------------------------------------------------------
AI_WORKSPACE_ROOT=.
AI_LOG_LEVEL=INFO
AI_RANDOM_SEED=42

# -----------------------------------------------------------------------------
# Ollama (primary inference)
# -----------------------------------------------------------------------------
OLLAMA_HOST=http://127.0.0.1:11434
# Optional. Unset = hardware-adaptive selection. Set to pin a model.
# OLLAMA_MODEL=qwen2.5:14b-instruct
OLLAMA_TIMEOUT_SECONDS=120

# -----------------------------------------------------------------------------
# Cloud providers (optional / benchmarking only)
# -----------------------------------------------------------------------------
# Leave blank for local Ollama-only parsing (recommended).
# Grok is disabled in runtime/config/runtime.production.yaml.
XAI_API_KEY=
XAI_MODEL=grok-4-fast-reasoning
XAI_BASE_URL=https://api.x.ai/v1

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Google Gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# -----------------------------------------------------------------------------
# Training (GPU / cloud)
# -----------------------------------------------------------------------------
HF_TOKEN=
WANDB_API_KEY=
WANDB_PROJECT=hrms-ai-parsing
CUDA_VISIBLE_DEVICES=0

# Hugging Face model registry (optional)
HF_HUB_ORG=
HF_HUB_MODEL_PREFIX=hrms-

# -----------------------------------------------------------------------------
# Dataset export from HRMS (read-only, future)
# -----------------------------------------------------------------------------
# HRMS_DATABASE_URL=postgresql://user:pass@localhost:5432/JobPortal
# HRMS_EXPORT_BATCH_SIZE=500
