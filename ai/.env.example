# =============================================================================
# AI Workspace — Environment Configuration
# =============================================================================
# Copy to .env and set values. Never commit .env.
# This workspace is independent of backend/.env (HRMS runtime).
# =============================================================================

# --- Workspace ---
AI_WORKSPACE_ROOT=.
AI_LOG_LEVEL=INFO
AI_RANDOM_SEED=42

# --- Ollama (primary inference target) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=hrms-resume-jd-parser
OLLAMA_TIMEOUT_SECONDS=120

# --- Cloud providers (secondary / fallback / benchmarking) ---
# Grok / X.AI (current HRMS production provider)
XAI_API_KEY=
XAI_MODEL=grok-4-fast-reasoning
XAI_BASE_URL=https://api.x.ai/v1

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Google Gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Training (GPU / cloud) ---
HF_TOKEN=
WANDB_API_KEY=
WANDB_PROJECT=hrms-ai-parsing
CUDA_VISIBLE_DEVICES=0

# --- Hugging Face model registry (optional) ---
HF_HUB_ORG=
HF_HUB_MODEL_PREFIX=hrms-

# --- Dataset export from HRMS (read-only, future milestone) ---
# HRMS_DATABASE_URL=postgresql://user:pass@localhost:5432/JobPortal
# HRMS_EXPORT_BATCH_SIZE=500
