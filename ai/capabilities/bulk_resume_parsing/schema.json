{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resume_v1",
  "title": "Resume Parse Output",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "resume"
    },
    "person": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "linkedin": {
          "type": "string",
          "format": "uri"
        },
        "github": {
          "type": "string",
          "format": "uri"
        },
        "portfolio": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "name",
        "email",
        "phone"
      ],
      "additionalProperties": true
    },
    "summary": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ]
          }
        ]
      }
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "company": {
            "type": "string"
          },
          "start_date": {
            "type": "string"
          },
          "end_date": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "years": {
            "type": "number"
          }
        },
        "additionalProperties": true
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "degree": {
            "type": "string"
          },
          "institution": {
            "type": "string"
          },
          "year": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "certifications": {
      "type": "array"
    },
    "languages": {
      "type": "array"
    },
    "total_experience_years": {
      "type": "number"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "type",
    "person",
    "skills",
    "experience",
    "education"
  ],
  "additionalProperties": true
}
