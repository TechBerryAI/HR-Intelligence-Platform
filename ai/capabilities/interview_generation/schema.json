{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "interview_v1",
  "title": "Interview Question Generation Output",
  "type": "object",
  "properties": {
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "technical",
              "behavioral",
              "situational",
              "culture"
            ]
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "easy",
              "medium",
              "hard"
            ]
          },
          "rationale": {
            "type": "string"
          }
        },
        "required": [
          "question",
          "category"
        ]
      },
      "minItems": 1
    },
    "focus_areas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "questions"
  ],
  "additionalProperties": true
}
