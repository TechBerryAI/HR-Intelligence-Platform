{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jd_v1",
  "title": "Job Description Parse Output",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "job_description"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "company": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "employment_type": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ]
          }
        ]
      }
    },
    "mandatory_skills": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ]
          }
        ]
      }
    },
    "preferred_skills": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ]
          }
        ]
      }
    },
    "responsibilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "qualifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "min_experience_years": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "max_experience_years": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "salary_range": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "type",
    "title",
    "location",
    "skills",
    "responsibilities"
  ],
  "additionalProperties": true
}
