{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate_match_v1",
  "title": "Candidate Match Output",
  "type": "object",
  "properties": {
    "match_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "overall_fit": {
      "type": "string",
      "enum": [
        "strong",
        "moderate",
        "weak",
        "no_match"
      ]
    },
    "skill_matches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "skill": {
            "type": "string"
          },
          "matched": {
            "type": "boolean"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "skill",
          "matched"
        ]
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rationale": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "match_score",
    "overall_fit",
    "skill_matches"
  ],
  "additionalProperties": true
}
