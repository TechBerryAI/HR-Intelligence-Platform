# Environment and secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# ── Dataset Factory inspection outputs ──
dataset/factory/inspector/outputs/**/*
!dataset/factory/inspector/outputs/.gitkeep

# ── Knowledge base shards (structure tracked, entry data gitignored) ──
knowledge/**/entries/**
!knowledge/**/entries/.gitkeep
knowledge/**/index.json

# ── Data lake (stage artifacts — structure tracked, data gitignored) ──
dataset/lake/raw/**/*
!dataset/lake/raw/**/.gitkeep
dataset/lake/extracted/**/*
!dataset/lake/extracted/.gitkeep
dataset/lake/cleaned/**/*
!dataset/lake/cleaned/.gitkeep
dataset/lake/normalized/**/*
!dataset/lake/normalized/.gitkeep
dataset/lake/jsonl/**/*
!dataset/lake/jsonl/.gitkeep
dataset/lake/benchmark/**/*
!dataset/lake/benchmark/.gitkeep
!dataset/lake/benchmark/README.md
dataset/lake/synthetic/**/*
!dataset/lake/synthetic/.gitkeep

# ── Silver layer (extracted text — PII) ──
dataset/lake/silver/**/*
!dataset/lake/silver/**/
!dataset/lake/silver/**/.gitkeep

# ── Proposal artifacts (derived labels — PII) ──
dataset/lake/proposals/**/*
!dataset/lake/proposals/**/
!dataset/lake/proposals/**/.gitkeep

# ── Inspector run outputs (filenames, hashes — PII metadata) ──
dataset/lake/inspection/**
!dataset/lake/inspection/.gitkeep

# ── Evaluation datasets ──
dataset/lake/evaluation/**
!dataset/lake/evaluation/.gitkeep

# ── Document binaries (never commit source resumes/JDs) ──
dataset/lake/**/*.pdf
dataset/lake/**/*.doc
dataset/lake/**/*.docx

# ── Local config copies (may contain secrets) ──
configs/*.yaml
!configs/*.yaml.example

# ── Models (weights and binaries — future training milestone) ──
*.gguf
*.safetensors
*.bin
*.pt
*.pth

# ── Experiment tracking ──
wandb/
mlruns/
tensorboard/
*.log

# OS
.DS_Store
Thumbs.db
