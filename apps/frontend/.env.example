# =============================================================================
# HCIP Frontend — Environment Configuration
# =============================================================================
# Copy to .env:
#   cp apps/frontend/.env.example apps/frontend/.env
# Keep aligned with apps/backend/.env (FRONTEND_URL / FRONTEND_URLS).
# Vite binds 0.0.0.0:5173 and proxies /api + /health → Flask :3000.
# =============================================================================

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
# Empty = same-origin (recommended for localhost + LAN via Vite proxy).
VITE_API_URL=
# Absolute URL only for split-origin production (not typical for this repo)
# VITE_API_URL=https://api.example.com
VITE_API_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# Public origin — should match backend FRONTEND_URL
# -----------------------------------------------------------------------------
VITE_PUBLIC_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# Dev server overrides (optional — defaults: 0.0.0.0:5173)
# -----------------------------------------------------------------------------
# VITE_DEV_HOST=0.0.0.0
# VITE_DEV_PORT=5173

# -----------------------------------------------------------------------------
# Landing hero video (optional CDN override)
# -----------------------------------------------------------------------------
# Default: same-origin /api/media/public/hero-video (Flask streams from MEDIA_ROOT)
# VITE_HERO_VIDEO_URL=https://cdn.example.com/website-hero.mp4
