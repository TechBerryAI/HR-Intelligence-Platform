# =============================================================================
# HR Intelligence Backend - Environment Configuration
# =============================================================================
# Copy to .env and set values.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=JobPortal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# Or use a single URL instead of the 5 vars above:
# DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/JobPortal

# --- App ---
PORT=3000
FLASK_DEBUG=true
JWT_SECRET=your-jwt-secret-change-in-production

# --- CORS / frontend origin ---
# Production: set to your public SPA origin (scheme + host + port if non-default).
# Same-origin reverse proxy (UI + /api + /health on one host): browsers do not need CORS
# for proxied API calls; still set FRONTEND_URL to the public origin for non-proxied access.
# Dev (FLASK_DEBUG=true): private LAN origin regexes are allowed automatically.
# FRONTEND_URL=https://app.example.com
# FRONTEND_URLS=https://app.example.com,http://localhost:5173

# --- Gunicorn (production behind reverse proxy) ---
# Keep 127.0.0.1 when nginx/Caddy proxies to this process (recommended same-origin setup).
# GUNICORN_BIND=127.0.0.1:3000
# GUNICORN_WORKERS=4
# GUNICORN_LOG_LEVEL=info

# --- Mail (OTP, notifications) ---
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_SUPPRESS_SEND=false

# --- Support & HRMS Feedback notifications (default: techberryaiteam@gmail.com) ---
# SUPPORT_NOTIFICATION_EMAIL=techberryaiteam@gmail.com
# FEEDBACK_NOTIFICATION_EMAIL=techberryaiteam@gmail.com
# AI_TEAM_EMAIL=techberryaiteam@gmail.com

# --- Parsing (optional cloud keys; local Ollama is default via AI Runtime) ---
# Leave blank unless you re-enable Grok in ai/runtime/config/runtime.production.yaml
# XAI_MODEL=grok-4-fast-reasoning
# HRMS_API_KEY_1=your-grok-api-key-1
# HRMS_API_KEY_2=your-grok-api-key-2
# HRMS_API_KEY_3=your-grok-api-key-3
# HRMS_API_KEY_4=your-grok-api-key-4
# Optional: timeouts and key rotation (legacy Grok path only)
# LLM_REQUEST_TIMEOUT=120
# LLM_KEY_COOLDOWN_SECONDS=45
# Bulk parse: hybrid rules/CV first, Ollama only when confidence is low
# BULK_PARSE_MAX_WORKERS=6
# OLLAMA_MAX_CONCURRENT=1
# BULK_LLM_ATTEMPTS=4
# BULK_EXCEL_CHECKPOINT_EVERY=25
# BULK_SKIP_LLM_WHEN_DETERMINISTIC=true
# RESUME_DET_CONFIDENCE=0.55
# RESUME_LAYOUT_ENABLED=true
# OCR_PREPROCESS=true
# OCR_DPI_FAST=180
# AI_PROVIDER_UNAVAILABLE_AFTER=12
# AI_PROVIDER_COOLDOWN_SECONDS=45
# Optional DocLayout weights if doclayout-yolo is installed:
# DOCLAYOUT_WEIGHTS=doclayout_yolo_docstructbench_imgsz1024.pt
# Upload body limits (Werkzeug 3.1 defaults are too small for bulk multipart)
# MAX_CONTENT_LENGTH=536870912
# MAX_FORM_MEMORY_SIZE=67108864
# MAX_FORM_PARTS=2000

# --- AI Runtime Gateway (Ollama only; Grok disabled in runtime.production.yaml) ---
AI_USE_GATEWAY=true
AI_RUNTIME_CONFIG=ai/runtime/config/runtime.production.yaml
# Runtime reads OLLAMA_HOST (OLLAMA_BASE_URL is accepted by start.js and mirrored)
OLLAMA_HOST=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b-instruct
# Optional: only needed if you re-enable Grok fallback
# XAI_API_KEY=
# XAI_MODEL=grok-4-fast-reasoning
# XAI_BASE_URL=https://api.x.ai/v1
# OCR (pip packages via requirements.txt; optional OCR_ENABLED=false to disable)
OCR_ENABLED=true
OCR_DPI=250
OCR_DPI_FAST=180
OCR_PREPROCESS=true
RESUME_LAYOUT_ENABLED=true
