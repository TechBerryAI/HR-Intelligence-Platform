# =============================================================================
# HCIP Backend — Environment Configuration
# =============================================================================
# Copy to .env and fill in secrets:
#   cp apps/backend/.env.example apps/backend/.env
# Never commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
PORT=3000
# Local development only. Production / Gunicorn MUST use:
#   FLASK_DEBUG=false
#   DEVELOPER_MODE=false
FLASK_DEBUG=true
FLASK_USE_RELOADER=false

# Admin-only Developer Mode (performance dashboard + in-memory timing collector).
# When false: collector inactive, APIs return 404, UI hidden. Restart after change.
# Production and Gunicorn refuse to start if this is true.
DEVELOPER_MODE=false
# DEVELOPER_MODE_MAX_SESSIONS=500

# -----------------------------------------------------------------------------
# CORS — comma-separated SPA origins (must match the browser URL)
# -----------------------------------------------------------------------------
# Dev (FLASK_DEBUG=true): private LAN origins are also allowed automatically.
# FRONTEND_URL=https://app.example.com
# FRONTEND_URLS=https://app.example.com,http://localhost:5173
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=JobPortal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
DB_POOL_SIZE=5
DB_CONNECTION_TIMEOUT=10
# Or a single URL instead of the vars above:
# DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/JobPortal

# -----------------------------------------------------------------------------
# Redis (optional shared state across workers)
# -----------------------------------------------------------------------------
# Redis — required in production when GUNICORN_WORKERS>1 (cross-worker parse join;
# Gunicorn default is 4). Also required if REDIS_URL is set (no silent memory fallback).
# JWT login, OTP, outbox, and bulk leases do not use Redis.
# Local FLASK_DEBUG=true does not require Redis. Single-worker production does not.
# Password special characters must be URL-encoded (e.g. / → %2F). Form:
#   redis://:URL_ENCODED_PASSWORD@host:6379/0
# REDIS_URL=redis://localhost:6379/0
# OAuth state TTL in seconds (default 600):
# OAUTH_STATE_TTL_SEC=600

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# REQUIRED in production (FLASK_DEBUG=false): unique secret ≥32 characters.
# Placeholders (including this example value) are rejected at startup unless
# FLASK_DEBUG=true or ALLOW_INSECURE_JWT=true.
# TRUST_PROXY_HEADERS=true   # set when behind nginx/Caddy so public parse rate limits use X-Forwarded-For
# OTP_RATE_LIMIT=8
# OTP_RATE_WINDOW_SEC=900
# ALLOW_INSECURE_JWT=false
# Required when N8N_WEBHOOK_URL is set (ATS callback auth):
# N8N_CALLBACK_SECRET=
# ALLOW_INSECURE_ATS_CALLBACK=false
# Shared secret for POST /api/platform/companies (create company + HEAD_HR).
# Generate a long random string; required header: X-Platform-Key
# PLATFORM_PROVISION_KEY=
# Public /api/jobs with no ?company= uses this org slug (or the sole org with jobs).
# DEFAULT_PUBLIC_COMPANY_SLUG=techberry-infotech
# Fernet key (or any secret string) for encrypting job-board provider credentials.
# REQUIRED in production (FLASK_DEBUG=false). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# INTEGRATION_SECRETS_KEY=
# ALLOW_INSECURE_INTEGRATION_SECRETS=false
# INTEGRATION_MAX_RETRIES=3
# INTEGRATION_RETRY_BASE_SECONDS=1.0
# INTEGRATION_WORKER_MAX_WORKERS=4
# INTEGRATION_AUTO_SYNC_INTERVAL_SECONDS=900
# Set ONLY on the dedicated scheduler process (not Gunicorn web workers):
# RUN_INTEGRATION_AUTO_SYNC=1
# LinkedIn Job Posting API is partner-only (Talent Solutions). Naukri has no
# public posting API in this codebase. Do not enable fake staging success.
# LINKEDIN_JOB_POSTING_VERSION=202603
# Request logging: json | text (default text)
# LOG_FORMAT=text

# -----------------------------------------------------------------------------
# Google Calendar interview scheduling (per-recruiter OAuth)
# -----------------------------------------------------------------------------
# Create OAuth client in Google Cloud Console (Calendar API + OAuth consent).
# Redirect URI must match exactly (also register it in the Google console).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Must match an Authorized redirect URI in Google Cloud Console exactly:
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
# INTERVIEW_DURATION_MINUTES=30
# INTERVIEW_LOOKAHEAD_DAYS=5
# INTERVIEW_TZ=Asia/Kolkata
# INTERVIEW_INVITE_TTL_HOURS=72
# Booking links use FRONTEND_URL + /book/<token>

# -----------------------------------------------------------------------------
# Email (Gmail App Password — not the account password)
# -----------------------------------------------------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER="HR Management System <your-email@gmail.com>"
MAIL_SUPPRESS_SEND=false
# MAIL_TIMEOUT=25
# MAIL_SEND_RETRIES=3
# SUPPORT_NOTIFICATION_EMAIL=techberryaiteam@gmail.com
# FEEDBACK_NOTIFICATION_EMAIL=techberryaiteam@gmail.com

# -----------------------------------------------------------------------------
# Gunicorn (production behind reverse proxy)
# -----------------------------------------------------------------------------
# MUST use: gunicorn -c gunicorn.conf.py wsgi:app
# Production web processes never run migrations. Migrate once, then set:
#   MIGRATIONS_ALREADY_APPLIED=true
# HCIP_MIGRATIONS_DONE=1 is the equivalent skip flag inherited by Gunicorn workers.
# See docs/DEVELOPMENT.md (Production release section).
# GUNICORN_BIND=127.0.0.1:3000
# GUNICORN_WORKERS=4
# GUNICORN_TIMEOUT=320
# GUNICORN_GRACEFUL_TIMEOUT=320
# GUNICORN_LOG_LEVEL=info
# HCIP_PROCESS_ROLE is set by gunicorn/scheduler/outbox/alembic entrypoints.
# HCIP_RELEASE_ID=20260812   # optional; appears in pg_stat_activity.application_name
# LOG_FORMAT=json   # JSON-ish request logs (see app/core/structured_logging.py)
# MIGRATIONS_ALREADY_APPLIED=true

# -----------------------------------------------------------------------------
# Durable data home (outside the project) — media bytes only
# -----------------------------------------------------------------------------
# Default: <parent-of-repo>/hcip-data (e.g. …/Projects/hcip-data), else ~/hcip-data
#   media/    = resumes / JDs / hero (MEDIA_ROOT)
# Postgres backups are owned by the DB team (not this app).
# HCIP_DATA_HOME=/mnt/d/Projects/hcip-data
# MEDIA_ROOT=                 # optional; default $HCIP_DATA_HOME/media
#
# Deprecated: UPLOAD_FOLDER — remapped to MEDIA_ROOT.
# UPLOAD_FOLDER=
# RESUME_PARSE_DEBUG=1
# MAX_CONTENT_LENGTH=536870912
# MAX_FORM_MEMORY_SIZE=67108864
# MAX_FORM_PARTS=2000

# -----------------------------------------------------------------------------
# AI Runtime — Ollama primary (Grok disabled in runtime.production.yaml)
# Set AI_USE_GATEWAY=false to use the legacy LLM_PROVIDER path below.
# Production must set OLLAMA_HOST (OLLAMA_BASE_URL is a legacy alias).
# Default below is the central LAN server; override per environment.
# -----------------------------------------------------------------------------
AI_USE_GATEWAY=true
AI_RUNTIME_CONFIG=ai/runtime/config/runtime.production.yaml
OLLAMA_HOST=http://192.168.1.200:11434
OLLAMA_BASE_URL=http://192.168.1.200:11434
# Optional. Unset = hardware-adaptive model (gpu_high=14b, gpu_mid/unknown=7b, cpu=3b).
# Set to pin a model and skip adaptive selection.
# OLLAMA_MODEL=qwen2.5:14b-instruct
# Optional hardware overrides when NVIDIA VRAM cannot be measured (AMD/Apple/Intel):
# HCIP_HARDWARE_PROFILE=gpu_high|gpu_mid|unknown|cpu
# HCIP_VRAM_MB=24576
OLLAMA_MAX_CONCURRENT=1
AI_PROVIDER_UNAVAILABLE_AFTER=12
AI_PROVIDER_COOLDOWN_SECONDS=45

# Optional cloud fallback (leave blank unless you re-enable Grok in YAML)
# XAI_API_KEY=
# XAI_MODEL=grok-4-fast-reasoning
# XAI_BASE_URL=https://api.x.ai/v1

# -----------------------------------------------------------------------------
# Parsing / OCR / Bulk
# -----------------------------------------------------------------------------
OCR_ENABLED=true
OCR_PREPROCESS=true
OCR_DPI=250
OCR_DPI_FAST=180
# PDF extraction: PyMuPDF is always primary. pdfplumber is chosen automatically
# when PyMuPDF text is thin, garbage, layout-broken, or table-like and poor.
# There is no PDF_ENABLE_PDFPLUMBER / PDF_PRIMARY_EXTRACTOR switch.
RESUME_LAYOUT_ENABLED=true
RESUME_DET_CONFIDENCE=0.55
BULK_PARSE_MAX_WORKERS=6
BULK_LLM_ATTEMPTS=4
BULK_EXCEL_CHECKPOINT_EVERY=25
BULK_SKIP_LLM_WHEN_DETERMINISTIC=true
# Bump after parser accuracy fixes so stale cache hits are skipped
DOCUMENT_INTELLIGENCE_CACHE_TAG=canonical-v8-exp-layout
# Residual Ollama fill (one attempt). Default 90s; must stay below GUNICORN_TIMEOUT.
# DOCUMENT_INTELLIGENCE_SEMANTIC_TIMEOUT_SEC=90
# DOCUMENT_INTELLIGENCE_SEMANTIC_AI=true
# RESUME_SKIP_LLM_WHEN_DETERMINISTIC=true
# BULK_PARSER_URL=http://localhost:8001
# DOCLAYOUT_WEIGHTS=doclayout_yolo_docstructbench_imgsz1024.pt
# PARSING_API_URL=http://localhost:4000
# PARSING_API_KEY=

# Legacy LLM path (used only when AI_USE_GATEWAY=false)
LLM_PROVIDER=ollama
# LLM_REQUEST_TIMEOUT=300
# LLM_KEY_COOLDOWN_SECONDS=45
# HRMS_API_KEY_1=
# HRMS_API_KEY_2=
# HRMS_API_KEY_3=
# HRMS_API_KEY_4=

# -----------------------------------------------------------------------------
# ATS matching
# -----------------------------------------------------------------------------
# Auto-shortlist at Strong Match (≥80%). Potential Match (40–79%) is review-only; <40% talent pool.
ATS_THRESHOLD=80
ATS_AUTO_SHORTLIST_MIN=80
# ATS_API_URL=
# ATS_API_KEY=

# -----------------------------------------------------------------------------
# Optional integrations
# -----------------------------------------------------------------------------
# N8N_WEBHOOK_URL=
# N8N_CALLBACK_SECRET=

# -----------------------------------------------------------------------------
# Resume E2E validation harness (dev only — keep token in sync with frontend)
# -----------------------------------------------------------------------------
# DOCUMENT_INTELLIGENCE_VALIDATION_PAYLOAD=true
# DOCUMENT_INTELLIGENCE_VALIDATION_TOKEN=resume-e2e-validation-token
