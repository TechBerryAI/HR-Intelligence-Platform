# =============================================================================
# HCIP Backend — Environment Configuration
# =============================================================================
# Copy to .env and fill in secrets:
#   cp apps/backend/.env.example apps/backend/.env
# Never commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
PORT=3000
FLASK_DEBUG=true
FLASK_USE_RELOADER=false

# Admin-only Developer Mode (performance dashboard + in-memory timing collector).
# When false: collector inactive, APIs return 404, UI hidden. Restart after change.
DEVELOPER_MODE=false
# DEVELOPER_MODE_MAX_SESSIONS=500

# -----------------------------------------------------------------------------
# CORS — comma-separated SPA origins (must match the browser URL)
# -----------------------------------------------------------------------------
# Dev (FLASK_DEBUG=true): private LAN origins are also allowed automatically.
# FRONTEND_URL=https://app.example.com
# FRONTEND_URLS=https://app.example.com,http://localhost:5173
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=JobPortal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
DB_POOL_SIZE=5
DB_CONNECTION_TIMEOUT=10
# Or a single URL instead of the vars above:
# DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/JobPortal

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
JWT_SECRET=your-jwt-secret-change-in-production
# Fernet key (or any secret string) for encrypting job-board provider credentials.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# INTEGRATION_SECRETS_KEY=
# INTEGRATION_MAX_RETRIES=3
# INTEGRATION_RETRY_BASE_SECONDS=1.0
# INTEGRATION_WORKER_MAX_WORKERS=4

# -----------------------------------------------------------------------------
# Google Calendar interview scheduling (per-recruiter OAuth)
# -----------------------------------------------------------------------------
# Create OAuth client in Google Cloud Console (Calendar API + OAuth consent).
# Redirect URI must match exactly (also register it in the Google console).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Must match an Authorized redirect URI in Google Cloud Console exactly:
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
# INTERVIEW_DURATION_MINUTES=30
# INTERVIEW_LOOKAHEAD_DAYS=5
# INTERVIEW_TZ=Asia/Kolkata
# INTERVIEW_INVITE_TTL_HOURS=72
# Booking links use FRONTEND_URL + /book/<token>

# -----------------------------------------------------------------------------
# Email (Gmail App Password — not the account password)
# -----------------------------------------------------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER="HR Management System <your-email@gmail.com>"
MAIL_SUPPRESS_SEND=false
# MAIL_TIMEOUT=25
# MAIL_SEND_RETRIES=3
# SUPPORT_NOTIFICATION_EMAIL=techberryaiteam@gmail.com
# FEEDBACK_NOTIFICATION_EMAIL=techberryaiteam@gmail.com

# -----------------------------------------------------------------------------
# Gunicorn (production behind reverse proxy)
# -----------------------------------------------------------------------------
# GUNICORN_BIND=127.0.0.1:3000
# GUNICORN_WORKERS=4
# GUNICORN_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Durable data home (outside the project) — media bytes only
# -----------------------------------------------------------------------------
# Default: <parent-of-repo>/hcip-data (e.g. …/Projects/hcip-data), else ~/hcip-data
#   media/    = resumes / JDs / hero (MEDIA_ROOT)
# Postgres backups are owned by the DB team (not this app).
# HCIP_DATA_HOME=/mnt/d/Projects/hcip-data
# MEDIA_ROOT=                 # optional; default $HCIP_DATA_HOME/media
#
# Deprecated: UPLOAD_FOLDER — remapped to MEDIA_ROOT.
# UPLOAD_FOLDER=
# RESUME_PARSE_DEBUG=1
# MAX_CONTENT_LENGTH=536870912
# MAX_FORM_MEMORY_SIZE=67108864
# MAX_FORM_PARTS=2000

# -----------------------------------------------------------------------------
# AI Runtime — Ollama primary (Grok disabled in runtime.production.yaml)
# Set AI_USE_GATEWAY=false to use the legacy LLM_PROVIDER path below.
# -----------------------------------------------------------------------------
AI_USE_GATEWAY=true
AI_RUNTIME_CONFIG=ai/runtime/config/runtime.production.yaml
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b-instruct
OLLAMA_MAX_CONCURRENT=1
AI_PROVIDER_UNAVAILABLE_AFTER=12
AI_PROVIDER_COOLDOWN_SECONDS=45

# Optional cloud fallback (leave blank unless you re-enable Grok in YAML)
# XAI_API_KEY=
# XAI_MODEL=grok-4-fast-reasoning
# XAI_BASE_URL=https://api.x.ai/v1

# -----------------------------------------------------------------------------
# Parsing / OCR / Bulk
# -----------------------------------------------------------------------------
OCR_ENABLED=true
OCR_PREPROCESS=true
OCR_DPI=250
OCR_DPI_FAST=180
RESUME_LAYOUT_ENABLED=true
RESUME_DET_CONFIDENCE=0.55
BULK_PARSE_MAX_WORKERS=6
BULK_LLM_ATTEMPTS=4
BULK_EXCEL_CHECKPOINT_EVERY=25
BULK_SKIP_LLM_WHEN_DETERMINISTIC=true
# Bump after parser accuracy fixes so stale cache hits are skipped
DOCUMENT_INTELLIGENCE_CACHE_TAG=canonical-v6-jd-coverage
# BULK_PARSER_URL=http://localhost:8001
# DOCLAYOUT_WEIGHTS=doclayout_yolo_docstructbench_imgsz1024.pt
# PARSING_API_URL=http://localhost:4000
# PARSING_API_KEY=

# Legacy LLM path (used only when AI_USE_GATEWAY=false)
LLM_PROVIDER=ollama
# LLM_REQUEST_TIMEOUT=300
# LLM_KEY_COOLDOWN_SECONDS=45
# HRMS_API_KEY_1=
# HRMS_API_KEY_2=
# HRMS_API_KEY_3=
# HRMS_API_KEY_4=

# -----------------------------------------------------------------------------
# ATS matching
# -----------------------------------------------------------------------------
# Auto-shortlist at Strong Match (≥80%). Potential Match (40–79%) is review-only; <40% talent pool.
ATS_THRESHOLD=80
ATS_AUTO_SHORTLIST_MIN=80
# ATS_API_URL=
# ATS_API_KEY=

# -----------------------------------------------------------------------------
# Optional integrations
# -----------------------------------------------------------------------------
# N8N_WEBHOOK_URL=
# N8N_CALLBACK_SECRET=

# -----------------------------------------------------------------------------
# Resume E2E validation harness (dev only — keep token in sync with frontend)
# -----------------------------------------------------------------------------
# DOCUMENT_INTELLIGENCE_VALIDATION_PAYLOAD=true
# DOCUMENT_INTELLIGENCE_VALIDATION_TOKEN=resume-e2e-validation-token
