# =============================================================================
# HR Job Portal Backend - Environment Configuration
# =============================================================================
# Copy to .env and set values. For PostgreSQL: set USE_POSTGRES=1 and POSTGRES_* below.
# =============================================================================

# --- PostgreSQL (use when USE_POSTGRES=1) ---
USE_POSTGRES=1
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=JobPortal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# Or use a single URL instead of the 5 vars above:
# DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/JobPortal

# --- SQL Server (used when USE_POSTGRES is not set) ---
# MSSQL_SERVER=localhost
# MSSQL_PORT=1433
# MSSQL_DATABASE=JobPortal
# MSSQL_USER=Test
# MSSQL_PASSWORD=Root@123
# MSSQL_ODBC_DRIVER={ODBC Driver 17 for SQL Server}

# --- App ---
PORT=3000
FLASK_DEBUG=true
JWT_SECRET=your-jwt-secret-change-in-production

# --- Mail (OTP, notifications) ---
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_SUPPRESS_SEND=false
