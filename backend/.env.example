# Backend Environment Configuration - PRODUCTION READY
#
# SETUP: 
#   1. Copy this file: copy .env.example .env
#   2. Change ONLY the database credentials (lines 20-21)
#   3. Run: .\run.ps1

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3000
FLASK_DEBUG=true
FLASK_USE_RELOADER=false  # CRITICAL: Must be false to avoid startup delays

# ============================================
# FRONTEND URLS
# ============================================
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173

# ============================================
# DATABASE CONFIGURATION
# ============================================
# ⚠️  CHANGE THESE TO YOUR SQL SERVER CREDENTIALS ⚠️
MSSQL_USER=YOUR_SQL_USERNAME
MSSQL_PASSWORD=YOUR_SQL_PASSWORD

# These defaults work for everyone
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=JobPortal
MSSQL_ODBC_DRIVER={SQL Server}

# Database Connection Pool Configuration
DB_POOL_SIZE=5
DB_CONNECTION_TIMEOUT=10

# ============================================
# SECURITY
# ============================================
JWT_SECRET=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyIjoiZXhhbXBsZSJ9.lGrIa8yMwsB_ZSrgoniyr5FF34e9tE7TJboLqTfvifE
