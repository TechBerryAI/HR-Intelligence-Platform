# Server Configuration
PORT=3000
FLASK_DEBUG=false

# Database Configuration (MS SQL Server)
MSSQL_SERVER=localhost
MSSQL_DATABASE=JobPortal
MSSQL_USER=Test
MSSQL_PASSWORD=Root@123
MSSQL_PORT=1433
MSSQL_ODBC_DRIVER={ODBC Driver 17 for SQL Server}

# JWT Configuration
JWT_SECRET=your-secret-jwt-key-here-change-in-production

# Frontend URLs (comma-separated)
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173

# Email Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com
MAIL_SUPPRESS_SEND=false

# Parsing API Configuration
PARSING_API_URL=http://localhost:4000
PARSING_API_KEY=your-parsing-api-key-here

# File Upload Configuration
UPLOAD_FOLDER=./uploads
MAX_UPLOAD_SIZE_MB=10
