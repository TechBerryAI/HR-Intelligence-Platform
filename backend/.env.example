# Backend Environment Configuration Example
# Copy this file to .env and update with your values

# Server Configuration
PORT=3000
FLASK_DEBUG=true

# Frontend URL(s) for CORS (comma-separated for multiple)
FRONTEND_URL=http://localhost:5173

# JWT Secret (generate a strong random secret for production)
JWT_SECRET=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyIjoiZXhhbXBsZSJ9.lGrIa8yMwsB_ZSrgoniyr5FF34e9tE7TJboLqTfvifE

# Database Configuration
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=JobPortal
MSSQL_USER=Test
MSSQL_PASSWORD=Root@123
MSSQL_ODBC_DRIVER={SQL Server}

# Email Configuration (Gmail SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com
MAIL_SUPPRESS_SEND=false

