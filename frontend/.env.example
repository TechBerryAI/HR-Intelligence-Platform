# Backend API URL
VITE_API_URL=http://localhost:3000

# API request timeout in milliseconds
VITE_API_TIMEOUT_MS=30000

# Parsing API URL (for resume/JD parsing)
VITE_PARSING_API_URL=http://localhost:4000
