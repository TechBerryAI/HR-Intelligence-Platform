# =============================================================================
# HR Job Portal Parsing API - Environment Configuration Template
# =============================================================================
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env: copy .env.example .env
# 2. Configure your LLM provider API key
#
# =============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development

# API Key for authentication (used by backend to call this service)
API_KEY=YOUR_PARSING_API_KEY

# =============================================================================
# LLM CONFIGURATION
# =============================================================================
# Choose ONE provider and configure its API key

# OpenAI (Recommended)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic Claude (Alternative)
# ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
# ANTHROPIC_MODEL=claude-3-opus-20240229

# X.AI Grok (Alternative)  
# XAI_API_KEY=YOUR_XAI_API_KEY
# XAI_MODEL=grok-4-fast-reasoning

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# FILE UPLOAD LIMITS
# =============================================================================
MAX_FILE_SIZE_MB=10
