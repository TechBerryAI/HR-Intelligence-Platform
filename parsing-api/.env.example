# Server Configuration
PORT=4000
NODE_ENV=production
API_KEY=your-secure-api-key-here

# LLM Configuration (Choose one or configure multiple)
# OpenAI
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-key
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# X.AI Grok
XAI_API_KEY=your-xai-key
XAI_MODEL=grok-beta
XAI_BASE_URL=https://api.x.ai/v1

# Preferred LLM Provider
LLM_PROVIDER=openai

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Limits
MAX_FILE_SIZE_MB=10
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/msword

# Processing Timeouts
PDF_EXTRACTION_TIMEOUT_MS=30000
LLM_REQUEST_TIMEOUT_MS=60000

# Logging
LOG_LEVEL=info

